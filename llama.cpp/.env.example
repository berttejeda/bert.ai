# llama.cpp server environment configuration
# Copy this file to ~/.ai/llama-server.env (or any path) and set the values you need.
# start.sh loads the file pointed to by LLAMA_ENV_FILE (default: ~/.ai/llama-server.env).

# Base directories
# AI_HOME="${HOME}/.ai"
# LLAMA_MCP_BASE_DIR="${AI_HOME}/mcp-servers"
# LLAMA_ENV_FILE="${HOME}/.ai/llama-server.env"

# Model selection
# LLAMA_MODEL="${HOME}/.ai/models/your-model/your-model.gguf"
# LLAMA_MODELS_PRESET="${HOME}/.ai/models.ini"

# Server binding and health-check URL
# LLAMA_HOST="http://127.0.0.1:11434"
# LLAMA_PORT="11434"
# LLAMA_BIND_HOST="127.0.0.1"

# Inference settings
# LLAMA_CTX="4096"
# LLAMA_GPU_LAYERS="99"
# LLAMA_FLASH_ATTN="0"
# LLAMA_CACHE_TYPE_K=""
# LLAMA_CACHE_TYPE_V=""

# RoPE scaling / YaRN (extend context beyond a model's native trained length)
# LLAMA_ROPE_SCALING=""        # none|linear|yarn
# LLAMA_ROPE_SCALE=""
# LLAMA_YARN_ORIG_CTX=""       # e.g. "262144" for Qwen3.8-27B
# LLAMA_YARN_EXT_FACTOR=""
# LLAMA_YARN_ATTN_FACTOR=""
# LLAMA_YARN_BETA_FAST=""
# LLAMA_YARN_BETA_SLOW=""

# Vision (mmproj) settings — only applied when a *mmproj* file is auto-detected
# LLAMA_IMAGE_MIN_TOKENS=""    # e.g. "1024" for Qwen-VL grounding tasks

# Built-in tools (comma-separated, or "all")
# LLAMA_TOOLS=""

# WebUI MCP proxy
# LLAMA_WEBUI_MCP_PROXY="0"

# Session name when using --screen
# LLAMA_SCREEN_NAME="llamacpp"

# Optional: download an extra GGUF model after the server starts
# EXTRA_MODEL_URL=""

# Optional: override the Docker/Podman socket used by MCP setup
# DOCKER_HOST=""
