# Lightweight image that carries only the built plugin artifacts.
# Used as an init container source in Kubernetes to copy the plugin
# into Grafana's plugin directory.
#
# Build:
#   npm run build
#   mage -v build:linux
#   docker buildx build --platform linux/amd64 -f Dockerfile.dist \
#     -t your-registry.example.com/panel-ai-rag-table:1.0.0 --push .
#
# The dist/ directory must be populated before building this image.

FROM busybox:1.36

COPY dist/ /plugin/
